# File: rider-pi-api.service
# Description: systemd unit for Rider Pi API (autostart).
# Created: 2026-02-17
# Last updated: 2026-02-24
# Install: sudo cp scripts/rider-pi-api.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable rider-pi-api && sudo systemctl start rider-pi-api

[Unit]
Description=Rider Pi API Server
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/rider-pi-api
# Use venv Python so installed deps (FastAPI, uvicorn, xgolib) are used
ExecStart=/home/pi/rider-pi-api/.venv/bin/python rider_pi_server.py
Restart=always
RestartSec=5
Environment=HOST=0.0.0.0
Environment=PORT=5050

[Install]
WantedBy=multi-user.target
