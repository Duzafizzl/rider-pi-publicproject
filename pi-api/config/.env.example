# File: .env.example
# Description: Example environment variables for Rider Pi API.
# Created: 2026-02-17
# Last updated: 2026-02-17
# Kopieren nach .env und anpassen.

HOST=0.0.0.0
PORT=5050
LOG_LEVEL=INFO

# SSH/Deploy (für deploy_rider_pi.sh, fetch_pi_status; echte .env liegt oft im übergeordneten Projekt):
# RIDER_PI_HOST=riderpi.local
# RIDER_PI_PASSWORD=  # optional, for scripts that use sshpass
# Default Pi user: pi → ssh pi@${RIDER_PI_HOST}

# Display: Beim Start Expression 1–35 auf dem LCD anzeigen (überblendet "Wifi unconnected" von Remix)
# RIDER_PI_DISPLAY_EXPRESSION_ON_START=1

# Optional (Phase 8, TTS):
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
