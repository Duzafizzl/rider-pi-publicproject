# File: .env.example
# Description: Example configuration for Rider-Pi MCP server. No hardcoded IPs.
# Created: 2026-02-18
# Last updated: 2026-02-18
# Copy to .env and set your values.

# Base URL of the Rider-Pi API (FastAPI on the Pi).
# Examples: http://riderpi.local:5050  or  http://192.168.1.100:5050
RIDER_PI_BASE_URL=http://YOUR_RIDER_PI_IP_OR_HOSTNAME:5050

# Timeout for HTTP requests (seconds).
RIDER_PI_TIMEOUT=10.0

# Optional: API prefix when reaching the Pi via a proxy (e.g. /api/rider-pi).
# Direct to Pi: leave empty or /api
# RIDER_PI_API_PREFIX=/api
